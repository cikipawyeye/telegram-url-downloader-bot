NODE_ENV=production
PORT=8000

# Required
BOT_TOKEN=replace_me
PUBLIC_BASE_URL=https://your-domain.example.com

# Random secret used to protect the webhook endpoint.
WEBHOOK_SECRET=replace_with_a_long_random_string

# Optional, but strongly recommended if you self-host Telegram Bot API locally
# Example: http://127.0.0.1:8081
TELEGRAM_API_ROOT=

# Temporary working directory inside the container/server
DOWNLOAD_DIR=/tmp/telegram-video-bot

# Max size accepted by the app before trying to send back to Telegram (bytes)
# 2147483648 = 2 GiB
MAX_FILE_SIZE_BYTES=2147483648

# Maximum runtime for one yt-dlp job in milliseconds
DOWNLOAD_TIMEOUT_MS=9000000

# Optional HTTP/HTTPS/SOCKS proxy used only by yt-dlp.
# Cloudflare WARP proxy mode listens locally as SOCKS5, for example:
# YTDLP_PROXY=socks5://127.0.0.1:40000
YTDLP_PROXY=

SCREENSHOT_COUNT=5

# Send the screenshots together with the video inside a single Telegram album
# (media group). When disabled, screenshots and the video are sent separately.
# Note: videos inside an album are compressed/lowered in quality by Telegram,
# so disable this if you prefer to keep the full-quality streamable video.
SEND_VIDEO_IN_ALBUM=true

# Maximum number of URLs allowed in a single bulk request to the /bulk endpoint.
MAX_BULK_URLS=20