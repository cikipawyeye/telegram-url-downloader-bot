NODE_ENV=production
PORT=8000

# Required
BOT_TOKEN=replace_me
PUBLIC_BASE_URL=https://your-domain.example.com

# Random secret used to protect the webhook endpoint.
WEBHOOK_SECRET=replace_with_a_long_random_string

# Optional, but strongly recommended if you self-host Telegram Bot API locally
# Example: http://127.0.0.1:8081
TELEGRAM_API_ROOT=

# Temporary working directory inside the container/server
DOWNLOAD_DIR=/tmp/telegram-video-bot

# Max size accepted by the app before trying to send back to Telegram (bytes)
# 2147483648 = 2 GiB
MAX_FILE_SIZE_BYTES=2147483648

# Maximum runtime for one yt-dlp job in milliseconds
DOWNLOAD_TIMEOUT_MS=9000000

# How many links may download at the same time, process-wide.
# Links are prefetched while earlier links are still converted/sent, so the
# default of 1 already means "download the next file while the current one is
# being delivered". Raise it only when the disk can hold several large files
# at once (each slot may add a 4 GB+ download).
DOWNLOAD_CONCURRENCY=1

# Disk admission control for large videos (bytes).
# A 4 GB+ video briefly needs its download plus the split/converted copy, so a
# download only starts while MIN_FREE_DISK_BYTES stays free after reserving
# DOWNLOAD_RESERVE_BYTES for every download that is already running.
# 6442450944 = 6 GiB, 4294967296 = 4 GiB.
MIN_FREE_DISK_BYTES=6442450944
DOWNLOAD_RESERVE_BYTES=4294967296

# Optional HTTP/HTTPS/SOCKS proxy used only by yt-dlp.
# Cloudflare WARP proxy mode listens locally as SOCKS5, for example:
# YTDLP_PROXY=socks5://127.0.0.1:40000
# Users can bypass it per Telegram message with the "noproxy" marker or
# /noproxy <link>.
YTDLP_PROXY=

SCREENSHOT_COUNT=5

# Send the screenshots together with the video inside a single Telegram album
# (media group). When disabled, screenshots and the video are sent separately.
# Note: videos inside an album are compressed/lowered in quality by Telegram,
# so disable this if you prefer to keep the full-quality streamable video.
SEND_VIDEO_IN_ALBUM=true

# Re-encode anamorphic (non-square pixel) videos to bake their true display
# dimensions. Costs one fast re-encode per affected video; when disabled, such
# videos are sent as-is and will look stretched in Telegram.
REENCODE_ANAMORPHIC=true

# Maximum number of URLs allowed in a single bulk request to the /bulk endpoint.
MAX_BULK_URLS=20

# DB path for the SQLite database file. If not set, defaults to $DOWNLOAD_DIR/bot.db
DB_PATH=

# How often (milliseconds) the app re-probes the gdown binary when handling a
# Google Drive link. Lets a running bot pick up gdown installed (or removed)
# later without a restart. 5 minutes by default; 0 re-probes on every request.
GDOWN_BINARY_RECHECK_MS=300000

# Optional explicit path to the gdown binary, used when gdown is not on the
# service PATH — e.g. a pip --user install under systemd where ~/.local/bin is
# not included:
# GDOWN_BINARY_PATH=/home/youruser/.local/bin/gdown
GDOWN_BINARY_PATH=

# --- Magnet / BitTorrent (aria2c) -----------------------------------------
# Magnet links are downloaded with the external `aria2c` binary (install the
# "aria2" package). The bot fetches the torrent metadata first, then downloads
# every video file inside the torrent and sends them one by one, in order.

# Largest single torrent file the bot will download, in bytes (0 = unlimited).
# 8589934592 = 8 GiB.
MAGNET_MAX_FILE_SIZE_BYTES=8589934592

# Extra BitTorrent tracker announce URIs (comma separated) appended to every
# magnet download. Helps magnets whose own trackers are dead: peers are then
# found through these trackers plus the DHT.
# MAGNET_EXTRA_TRACKERS=udp://tracker.opentrackr.org:1337/announce,udp://open.demonii.com:1337/announce

# How often (milliseconds) the app re-probes the aria2c binary when handling a
# magnet link (same policy as GDOWN_BINARY_RECHECK_MS).
ARIA2_BINARY_RECHECK_MS=300000

# Optional explicit path to the aria2c binary (same purpose as
# GDOWN_BINARY_PATH).
ARIA2_BINARY_PATH=